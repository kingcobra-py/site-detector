[Unit]
Description=Site Detector
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/site-detector
ExecStart=/usr/bin/node /opt/site-detector/server/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3001
Environment=DATA_DIR=/opt/site-detector/data
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
